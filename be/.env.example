NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://groomingspa_user:groomingspa_password@localhost:5433/groomingspa_db
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@groomingspa.com
FRONTEND_URL=http://localhost:5173
# Zona horaria del negocio: define "hoy" y "mañana" para las citas (HU-009)
BUSINESS_TIMEZONE=America/Bogota
